# Copy to .env and fill in. All values are optional except the shared LLM
# fallback if you want answers without per-user keys.

# --- Shared fallback LLM ------------------------------------------------------
CODEATLAS_LLM_PROVIDER=openai_compatible      # openai_compatible | anthropic_compatible
CODEATLAS_LLM_BASE_URL=
CODEATLAS_LLM_API_KEY=
CODEATLAS_LLM_MODEL=kimi-2.5
# Optional comma-separated exact host allowlist for OpenAI/Anthropic-compatible URLs.
CODEATLAS_LLM_ALLOWED_HOSTS=
# Keep false unless a deliberately configured compatible endpoint runs on localhost.
CODEATLAS_LLM_ALLOW_LOCAL_BASE_URLS=false

# --- Reserved Ollama placeholder (disabled and hidden from users) -------------
CODEATLAS_ENABLE_OLLAMA=false
# CODEATLAS_OLLAMA_URL=http://localhost:11434
# CODEATLAS_OLLAMA_MODEL=qwen2.5-coder:7b

# --- Agentic retrieval -------------------------------------------------------
# Tool-capable models search/read iteratively. Unsupported models automatically
# fall back to the original one-shot RAG path.
CODEATLAS_AGENT_ENABLED=true
CODEATLAS_AGENT_MAX_ROUNDS=8
CODEATLAS_AGENT_MAX_TOOL_CALLS=24
# Related follow-ups reuse server-side verified evidence for this many seconds.
# State is in-process, contains no credentials, and safely falls back to full retrieval.
CODEATLAS_CONVERSATION_TTL_SECONDS=1800
CODEATLAS_CONVERSATION_MAX_STATES=200
CODEATLAS_CONVERSATION_MAX_TURNS=4
CODEATLAS_CONVERSATION_MAX_ANSWER_CHARS=8000
CODEATLAS_CONVERSATION_MAX_CACHED_ANSWERS=500
# Repo-scoped cache: a fresh question answered by the shared LLM tier is
# reusable by any user asking the same thing against the same indexed
# revision, not just within one user's own session. BYOK answers are never
# cached here.
CODEATLAS_REPO_ANSWER_CACHE_TTL_SECONDS=21600
CODEATLAS_REPO_ANSWER_CACHE_MAX_ENTRIES=1000
# Compact, tool-free follow-up request limits. Missing evidence automatically
# triggers the normal full retrieval path.
CODEATLAS_FOLLOW_UP_MAX_TOKENS=800
CODEATLAS_FOLLOW_UP_EVIDENCE_CHARS=10000
CODEATLAS_FOLLOW_UP_TURN_ANSWER_CHARS=2500
# Keep the service responsive during bursts of long-running LLM requests.
CODEATLAS_MAX_CONCURRENT_LLM_REQUESTS=12
CODEATLAS_MAX_QUEUED_LLM_REQUESTS=20
CODEATLAS_LLM_QUEUE_TIMEOUT_SECONDS=15
# Additional attempts for connection errors and provider 429/502/503/504.
CODEATLAS_PROVIDER_RETRIES=2
# Optional web Ask UI image attachments. Images are transient request context only.
CODEATLAS_QUERY_IMAGE_MAX_COUNT=3
CODEATLAS_QUERY_IMAGE_MAX_BYTES=5242880
# CODEATLAS_AGENT_READ_LINES=240
# CODEATLAS_AGENT_READ_CHARS=30000
# CODEATLAS_AGENT_READ_FILE_BYTES=2000000
# CODEATLAS_AGENT_SEARCH_FILES=3000
# CODEATLAS_AGENT_SEARCH_FILE_BYTES=300000
# CODEATLAS_AGENT_TOOL_RESULT_CHARS=45000

# --- Paths / workspaces ------------------------------------------------------
# CODEATLAS_DATA_DIR=./data
# Compose/VM host path mounted at /app/data inside the container.
# CODEATLAS_DATA_PATH=/srv/codeatlas/data
# CODEATLAS_BIND_ADDRESS=0.0.0.0
# CODEATLAS_PORT=8000
# Optional read-only GitHub credential for private GitHub clones/fetches.
# Prefer a GitHub App installation token long-term, or a fine-grained PAT
# from a dedicated codeatlas-bot account with Contents: read on selected repos.
# Inject from GCP Secret Manager in production; never commit real values.
# GH_TOKEN=
# Optional read-only Bitbucket credential for private Bitbucket clones/fetches.
# Use a repository/project/workspace access token or bot API token with
# read:repository:bitbucket access only.
# CODEATLAS_BITBUCKET_API_TOKEN=
# CODEATLAS_DEFAULT_WORKSPACE=default
# Point the default workspace's graph at an existing graph.json:
# CODEATLAS_GRAPH_PATH=/abs/path/to/graph.json
# Root of the indexed source tree (for code excerpts) when not using a clone:
# CODEATLAS_SOURCE_ROOT=/abs/path/to/source/repo
# Wait for a concurrent SQLite writer instead of failing immediately.
CODEATLAS_SQLITE_BUSY_TIMEOUT_MS=10000

# Prefer injecting this from GCP Secret Manager in production. If omitted,
# CodeAtlas generates data/secret.key, which must be included in backups.
# CODEATLAS_SECRET_KEY=

# --- Sessions and login throttling -------------------------------------------
# Hybrid migration path:
#   password = existing username/password only
#   mixed    = username/password plus Google sign-in
#   google   = Google sign-in only
CODEATLAS_AUTH_MODE=password
# Google Sign-In web client ID from Google Cloud Console.
# CODEATLAS_GOOGLE_CLIENT_ID=
# Optional comma-separated domain allowlist, e.g. company.com,gmail.com.
# CODEATLAS_GOOGLE_ALLOWED_DOMAINS=
# Keep false to require admins to grant/provision Google emails before login.
CODEATLAS_GOOGLE_AUTO_CREATE=false
# Set false only for local HTTP development; production cookies default Secure.
CODEATLAS_COOKIE_SECURE=true
CODEATLAS_SESSION_MAX_AGE_SECONDS=2592000
CODEATLAS_LOGIN_RATE_LIMIT=10
CODEATLAS_LOGIN_RATE_WINDOW_SECONDS=300

# --- Branch freshness and in-process indexing --------------------------------
CODEATLAS_BRANCH_SYNC_MAX_WORKERS=2
CODEATLAS_BRANCH_SYNC_POLL_SECONDS=60
CODEATLAS_BRANCH_FRESHNESS_INTERVAL_SECONDS=300
CODEATLAS_BRANCH_USER_SYNC_COOLDOWN_SECONDS=60
CODEATLAS_BRANCH_VERSION_RETENTION_SECONDS=86400

# --- Slack org ask surface ----------------------------------------------------
# Slack slash command /codeatlas. Keep disabled until the Slack app is configured.
CODEATLAS_SLACK_ENABLED=
# Slack app Signing Secret. Used to verify every slash-command/interactivity request.
CODEATLAS_SLACK_SIGNING_SECRET=
# Bot User OAuth Token, required for opening modals and posting ephemeral answers.
CODEATLAS_SLACK_BOT_TOKEN=
# Optional comma-separated allowlists. Recommended in production.
# CODEATLAS_SLACK_ALLOWED_TEAM_IDS=
# CODEATLAS_SLACK_ALLOWED_ENTERPRISE_IDS=
# Slack questions use the same answer engine as the web UI; no per-user BYOK is used.
CODEATLAS_SLACK_LLM_MODE=
CODEATLAS_SLACK_MAX_WORKERS=
# Maximum time a Slack background answer job waits for branch sync/index completion.
CODEATLAS_SLACK_BRANCH_WAIT_SECONDS=
